rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isWhitelisted() {
      return request.auth != null
        && request.auth.token.email in [
          'electronica.zenner@gmail.com'
          // TODO: agregar los correos autorizados restantes
        ];
    }
    match /{document=**} {
      // TODO: restringir nuevamente a isWhitelisted() cuando se reactive el login.
      // Actualmente abierto porque la app no requiere autenticacion.
      allow read, write: if true;
    }
  }
}
